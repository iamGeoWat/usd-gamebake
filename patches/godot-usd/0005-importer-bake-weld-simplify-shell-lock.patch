+
+// an EditorSceneFormatImporter's tree must OWN its descendants (as GLTFDocument::generate_scene does), or
+// ResourceImporterScene packs only the root and the bake is an empty Node3D.
+void set_owner_recursive(Node *p_node, Node *p_owner) {
+	for (int i = 0; i < p_node->get_child_count(); i++) {
+		Node *c = p_node->get_child(i);
+		c->set_owner(p_owner);
+		set_owner_recursive(c, p_owner);
+	}
+}
+
+// the loader adds a preview WorldEnvironment + sun (usd:preview_only) when the stage authors no lights; a BAKED
+// asset must not carry them (they rode into the GLB as KHR_lights_punctual and would light the scene the asset is placed in).
+void strip_preview_nodes_recursive(Node *p_node) {
+	for (int i = p_node->get_child_count() - 1; i >= 0; i--) {
+		Node *c = p_node->get_child(i);
+		const Dictionary md = godot_usd::get_usd_metadata(c);
+		if (md.has("usd:preview_only") && bool(md["usd:preview_only"])) {
+			p_node->remove_child(c);
+			memdelete(c);
+			continue;
+		}
+		strip_preview_nodes_recursive(c);
+	}
+}

+UsdStageInstance *find_stage_instance(Node *p_node) {
+	UsdStageInstance *si = Object::cast_to<UsdStageInstance>(p_node);
+	if (si != nullptr) {
+		return si;
+	}
+	for (int i = 0; i < p_node->get_child_count(); i++) {
+		UsdStageInstance *found = find_stage_instance(p_node->get_child(i));
+		if (found != nullptr) {
+			return found;
+		}
+	}
+	return nullptr;
+}

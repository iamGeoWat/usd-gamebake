+// a UDIM atlas maps through the material's uv1 transform (the mesh builder writes v = 1 - v_usd)
+static void apply_udim_uv(StandardMaterial3D *p_material) {
+	const Vector2i grid = usd_udim_last_grid();
+	if (p_material == nullptr || grid.x <= 0 || grid.y <= 0) {
+		return;
+	}
+	p_material->set_uv1_scale(Vector3(1.0f / grid.x, 1.0f / grid.y, 1.0f));
+	p_material->set_uv1_offset(Vector3(0.0f, float(grid.y - 1) / grid.y, 0.0f));
+}
